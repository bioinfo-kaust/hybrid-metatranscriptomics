/*
 * Resource tiers. Every process carries a label; override a single process with
 *   withName: 'TRINITY' { cpus = 48; memory = '400.GB' }
 * in your own config rather than editing this file.
 */

process {
    cpus   = { check_max( 2     * task.attempt, 'cpus'   ) }
    memory = { check_max( 8.GB  * task.attempt, 'memory' ) }
    time   = { check_max( 4.h   * task.attempt, 'time'   ) }

    errorStrategy = { task.exitStatus in ((130..145) + 104) ? 'retry' : 'finish' }
    maxRetries    = 2
    maxErrors     = '-1'

    withLabel: process_single {
        cpus   = { check_max( 1                  , 'cpus'   ) }
        memory = { check_max( 6.GB * task.attempt, 'memory' ) }
        time   = { check_max( 4.h  * task.attempt, 'time'   ) }
    }
    withLabel: process_low {
        cpus   = { check_max( 4     * task.attempt, 'cpus'   ) }
        memory = { check_max( 16.GB * task.attempt, 'memory' ) }
        time   = { check_max( 6.h   * task.attempt, 'time'   ) }
    }
    withLabel: process_medium {
        cpus   = { check_max( 16    * task.attempt, 'cpus'   ) }
        memory = { check_max( 64.GB * task.attempt, 'memory' ) }
        time   = { check_max( 12.h  * task.attempt, 'time'   ) }
    }
    withLabel: process_high {
        cpus   = { check_max( 32                  , 'cpus'   ) }
        memory = { check_max( 250.GB * task.attempt, 'memory' ) }
        time   = { check_max( 1.d    * task.attempt, 'time'   ) }
    }
    withLabel: process_long {
        time   = { check_max( 4.d * task.attempt, 'time' ) }
    }
    withLabel: process_high_memory {
        memory = { check_max( 300.GB * task.attempt, 'memory' ) }
    }
    // network-bound reference downloads: single CPU, retry on transient failures
    withLabel: process_download {
        cpus          = 1
        memory        = { check_max( 8.GB, 'memory' ) }
        time          = { check_max( 8.h,  'time'   ) }
        errorStrategy = { task.attempt <= 3 ? 'retry' : 'finish' }
        maxRetries    = 3
        maxForks      = 2
    }
    // a failed leaf analysis must not kill the run
    withLabel: error_ignore { errorStrategy = 'ignore' }
}
