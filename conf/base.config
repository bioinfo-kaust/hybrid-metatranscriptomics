/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    bioinfo-kaust/hybridmetatranscriptomics Nextflow base config file
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Resource tiers by label. Most processes are overridden in conf/modules.config with values
    measured on the Cassiopea run; override a single process in your own config with
        process { withName: 'TRINITY' { cpus = 48; memory = 400.GB } }
    rather than editing this file. `resourceLimits` caps every request to the largest node:
    lower it to fit yours.
----------------------------------------------------------------------------------------
*/

process {

    cpus   = { 2     * task.attempt }
    memory = { 8.GB  * task.attempt }
    time   = { 4.h   * task.attempt }

    resourceLimits = [ cpus: 64, memory: 500.GB, time: 14.d ]

    errorStrategy = { task.exitStatus in ((130..145) + 104 + (175..177)) ? 'retry' : 'finish' }
    maxRetries    = 2
    maxErrors     = '-1'

    withLabel:process_single {
        cpus   = { 1                   }
        memory = { 6.GB * task.attempt }
        time   = { 4.h  * task.attempt }
    }
    withLabel:process_low {
        cpus   = { 4     * task.attempt }
        memory = { 16.GB * task.attempt }
        time   = { 6.h   * task.attempt }
    }
    withLabel:process_medium {
        cpus   = { 16    * task.attempt }
        memory = { 64.GB * task.attempt }
        time   = { 12.h  * task.attempt }
    }
    withLabel:process_high {
        cpus   = { 32                   }
        memory = { 250.GB * task.attempt }
        time   = { 1.d    * task.attempt }
    }
    withLabel:process_long {
        time   = { 4.d  * task.attempt }
    }
    withLabel:process_low_memory {
        memory = { 1.GB * task.attempt }
    }
    withLabel:process_high_memory {
        memory = { 300.GB * task.attempt }
    }
    // network-bound reference downloads: single CPU, retry on transient failures
    withLabel:process_download {
        cpus          = 1
        memory        = 8.GB
        time          = 8.h
        errorStrategy = { task.attempt <= 3 ? 'retry' : 'finish' }
        maxRetries    = 3
        maxForks      = 2
    }
    // a failed leaf analysis must not kill the run
    withLabel:error_ignore {
        errorStrategy = 'ignore'
    }
    withLabel:error_retry {
        errorStrategy = 'retry'
        maxRetries    = 2
    }
}
