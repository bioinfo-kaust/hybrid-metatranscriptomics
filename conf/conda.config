/*
 * Conda provisioning — an alternative to -profile envmodules for sites without modules.
 *
 * As with envmodules, this only flips a switch: the package specs live in `params.conda_pkg`
 * (nextflow.config) and are attached per process in conf/modules.config. Nextflow builds the
 * environments on first use.
 */

conda.enabled = true

params {
    use_conda_pkgs = true
}
