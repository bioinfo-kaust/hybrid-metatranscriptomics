/*
 * Tool provisioning through environment modules (`module load`).
 *
 * This profile only flips a switch: the module names live in `params.mod` (nextflow.config) and
 * are attached to each process in conf/modules.config, next to that process's arguments and
 * publishing rules.
 *
 * Why not `withName:` blocks here? A `withName:` block declared in a profile REPLACES the base
 * config's block for that process — `ext.args` and `publishDir` included — so provisioning
 * declared this way would silently strip the tool arguments and scatter the published outputs.
 *
 * Change a version in one place:
 *   nextflow run . -profile hpc,envmodules --mod.minimap2 minimap2/2.31
 *
 * Tools with no module on your cluster (TransDecoder, gffread, CPC2 here) come from
 * params.extra_path, which is prepended to PATH for the processes that need them.
 */

params {
    use_modules = true
}
