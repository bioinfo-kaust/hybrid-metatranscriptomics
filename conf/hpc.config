/*
 * Generic SLURM cluster. Account and partition are parameters (--slurm_account, --slurm_partition) — change them for another cluster
 * or another allocation without touching the workflow.
 */

process {
    executor       = 'slurm'
    queue          = params.slurm_partition
    clusterOptions = { "${params.slurm_account ? '--account=' + params.slurm_account : ''} ${params.slurm_extra ?: ''}".trim() }
    scratch        = false          // node-local TMPDIR is often small; Trinity/STAR want a big shared cwd
    maxRetries     = 2
}

executor {
    name            = 'slurm'
    queueSize       = 64
    submitRateLimit = '20/1min'
    pollInterval    = '30 sec'
}

// per-task caps; lower them to fit the largest node on your cluster
process.resourceLimits = [ cpus: 64, memory: 500.GB, time: 14.d ]
