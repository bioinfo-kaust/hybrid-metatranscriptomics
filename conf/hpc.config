/*
 * Generic SLURM cluster. Account and partition are parameters — change them for another cluster
 * or another allocation without touching the workflow.
 */

params {
    slurm_account   = null          // your allocation; set it in your params file or a -c config
    slurm_partition = 'batch'
    slurm_extra     = ''            // e.g. '--qos=normal --constraint=cascadelake'
}

process {
    executor       = 'slurm'
    queue          = params.slurm_partition
    clusterOptions = { "${params.slurm_account ? '--account=' + params.slurm_account : ''} ${params.slurm_extra}".trim() }
    scratch        = false          // node-local TMPDIR is often small; Trinity/STAR want a big shared cwd
    maxRetries     = 2
}

executor {
    name            = 'slurm'
    queueSize       = 64
    submitRateLimit = '20/1min'
    pollInterval    = '30 sec'
}

// per-task caps; lower them to fit the largest node on your cluster
params.max_cpus   = 64
params.max_memory = '500.GB'
params.max_time   = '14.d'
