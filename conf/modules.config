/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Config file for defining DSL2 per module options and publishing paths
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Available keys to override module options:
        ext.args   = Additional arguments appended to command in module.
        ext.args2  = Second set of arguments appended to command in module (multi-tool modules).
        ext.args3  = Third set of arguments appended to command in module (multi-tool modules).
        ext.prefix = File name prefix for output files.

    Per-process tool arguments, resources, publishing and environment modules live together on
    purpose: a `withName:` block declared in a profile replaces the base block for that process
    wholesale, so splitting provisioning into a profile would silently drop the arguments and
    publishing rules set here.

    Resources are the values measured on the Cassiopea run (comments give the measurement);
    `resourceLimits` in conf/base.config caps them to the node size. `module` is empty unless
    -profile envmodules is active, which loads the names in params.mod; containers and conda
    provision the tools themselves. Empty, not null: a null module directive aborts the task.

    Selectors name every alias explicitly, so a process included under two names is configured
    in one place and nothing depends on whether the base name also matches.
----------------------------------------------------------------------------------------
*/

process {

    publishDir = [
        path: { "${params.outdir}/${task.process.tokenize(':')[-1].toLowerCase()}" },
        mode: params.publish_dir_mode,
        saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
    ]

    // tools that may live outside the module system (TransDecoder, gffread on Ibex)
    withName: 'TRANSDECODER_LONGORF|TRANSDECODER_PREDICT|STRINGTIE_NOVEL|LONGREAD_GENOME_SEQ' {
        beforeScript = { params.extra_path ? "export PATH=${params.extra_path}:\$PATH" : '' }
    }

    // ------------------------------------------------------------------ references
    withName: 'DOWNLOAD_GENOME|DOWNLOAD_CONTAMINANT_GENOMES' {
        // network-bound
        module     = { params.use_modules ? ['datasets', 'seqkit'].collect { n -> params.mod[n] }.join(':') : '' }
        publishDir = [ path: { "${params.outdir}/references" }, mode: params.publish_dir_mode, saveAs: { fn -> fn.equals('versions.yml') ? null : fn } ]
    }
    withName: 'DOWNLOAD_RRNA_DB|DOWNLOAD_PROTEIN_DB|COMBINE_CONTAMINANTS' {
        // network-bound
        module     = { params.use_modules ? ['seqkit'].collect { n -> params.mod[n] }.join(':') : '' }
        publishDir = [ path: { "${params.outdir}/references" }, mode: params.publish_dir_mode, saveAs: { fn -> fn.equals('versions.yml') ? null : fn } ]
    }
    withName: 'COMBINE_CONTAMINANTS' {
        cpus   = { 1 }
        memory = { 8.GB * task.attempt }
        time   = { 8.h  * task.attempt }
    }
    withName: 'GUNZIP_GENOME' {
        publishDir = [ enabled: false ]
    }
    withName: 'DIAMOND_MAKEDB' {
        // diamond makedb on Swiss-Prot
        cpus       = { 8 }
        memory     = { 32.GB * task.attempt }
        time       = { 4.h   * task.attempt }
        module     = { params.use_modules ? ['diamond'].collect { n -> params.mod[n] }.join(':') : '' }
        publishDir = [ path: { "${params.outdir}/references" }, mode: params.publish_dir_mode, saveAs: { fn -> fn.equals('versions.yml') ? null : fn } ]
    }
    withName: 'STAR_GENOMEGENERATE' {
        // measured 2 min at 16 cpus / 64 GB
        cpus       = { 16 }
        memory     = { 64.GB * task.attempt }
        time       = { 8.h   * task.attempt }
        // Both are the size-dependent scalings STAR's own help prescribes for this genome
        // (406,637,004 bp in 101,352 scaffolds):
        //   genomeSAindexNbases = min(14, log2(L)/2 - 1)              = 13.30 -> 13
        //   genomeChrBinNbits   = min(18, log2(max(L/N, readlen)))    = 11.97 -> 12
        // The second matters because this assembly is fragmented: at STAR's default of 18 the
        // index allocates N * 2^18 = 24.7 GB of chromosome bins, against 0.39 GB at 12.
        ext.args   = '--genomeSAindexNbases 13 --genomeChrBinNbits 12'
        module     = { params.use_modules ? ['star', 'samtools'].collect { n -> params.mod[n] }.join(':') : '' }
        publishDir = [ path: { "${params.outdir}/references" }, mode: params.publish_dir_mode,
                       saveAs: { fn -> fn.equals('versions.yml') ? null : (fn == 'star' ? 'star_index' : fn) } ]
    }
    withName: 'SEQ_STATS|SEQ_STATS_EXPR' {
        // seqkit stats
        cpus       = { 1 }
        memory     = { 4.GB * task.attempt }
        time       = { 1.h  * task.attempt }
        // the plain tabular columns route_contribution and the reports read (not --all)
        ext.args   = '--tabular'
        ext.prefix = { "${meta.id}.stats" }
        module     = { params.use_modules ? ['seqkit'].collect { n -> params.mod[n] }.join(':') : '' }
        publishDir = [ path: { "${params.outdir}/transcriptome/qc" }, mode: params.publish_dir_mode, saveAs: { fn -> fn.equals('versions.yml') ? null : fn } ]
    }

    // ------------------------------------------------------------------ read QC
    withName: 'CAT_FASTQ|LONGREAD_PREP|LONGREAD_POOL' {
        // I/O bound: gzip concat, no decompression
        cpus       = { 2 }
        memory     = { 16.GB * task.attempt }
        time       = { 8.h   * task.attempt }
        module     = { params.use_modules ? ['seqkit'].collect { n -> params.mod[n] }.join(':') : '' }
        publishDir = [ enabled: false ]
    }
    withName: 'LONGREAD_MEMBERSHIP' {
        // grep over FASTA headers
        cpus       = { 1 }
        memory     = { 4.GB * task.attempt }
        time       = { 2.h  * task.attempt }
        publishDir = [ enabled: false ]
    }
    withName: 'FASTP' {
        // CPU-bound, small footprint. The module adds --detect_adapter_for_pe for paired reads.
        cpus       = { 12 }
        memory     = { 24.GB * task.attempt }
        time       = { 8.h   * task.attempt }
        ext.args   = ''
        module     = { params.use_modules ? ['fastp'].collect { n -> params.mod[n] }.join(':') : '' }
        publishDir = [ path: { "${params.outdir}/qc/fastp" }, mode: params.publish_dir_mode, pattern: '*.{json,html,log}' ]
    }
    withName: 'BBMAP_BBDUK|BBDUK_RRNA_SE' {
        // the original run used -Xmx48g
        cpus       = { 12 }
        memory     = { 48.GB * task.attempt }
        time       = { 12.h  * task.attempt }
        ext.args   = { "k=${params.rrna_kmer}" }
        module     = { params.use_modules ? ['bbtools', 'seqkit'].collect { n -> params.mod[n] }.join(':') : '' }
        publishDir = [ path: { "${params.outdir}/qc/rrna" }, mode: params.publish_dir_mode, pattern: '*.{txt,log,tsv}' ]
    }
    withName: 'RRNA_SUMMARY' {
        cpus       = { 1 }
        memory     = { 2.GB * task.attempt }
        time       = { 1.h  * task.attempt }
        publishDir = [ path: { "${params.outdir}/qc/rrna" }, mode: params.publish_dir_mode, pattern: '*.tsv' ]
    }
    withName: 'FASTQC' {
        // ~1 GB per thread
        cpus       = { 6 }
        memory     = { 16.GB * task.attempt }
        time       = { 6.h   * task.attempt }
        module     = { params.use_modules ? ['fastqc'].collect { n -> params.mod[n] }.join(':') : '' }
        publishDir = [ path: { "${params.outdir}/qc/fastqc" }, mode: params.publish_dir_mode, pattern: '*.{html,zip}' ]
    }

    // ------------------------------------------------------------------ decontamination
    withName: 'BUILD_DECON_INDEX' {
        // measured 4 min; minimap2 -x sr index of a 3.2 Gb reference
        cpus       = { 16 }
        memory     = { 96.GB * task.attempt }
        time       = { 8.h   * task.attempt }
        module     = { params.use_modules ? ['minimap2', 'seqkit', 'samtools'].collect { n -> params.mod[n] }.join(':') : '' }
        publishDir = [ path: { "${params.outdir}/decontam" }, mode: params.publish_dir_mode, pattern: '*.log' ]
    }
    withName: 'DECONTAM_SHORT' {
        // original run: 24 cpus / 150 GB per sample
        cpus       = { 24 }
        memory     = { 96.GB * task.attempt }
        time       = { 1.d   * task.attempt }
        module     = { params.use_modules ? ['minimap2', 'samtools', 'seqkit'].collect { n -> params.mod[n] }.join(':') : '' }
        // host-only reads are large: publish the accounting always, the reads only on request
        publishDir = [
            [ path: { "${params.outdir}/qc/decontam" }, mode: params.publish_dir_mode, pattern: '*.{tsv,log}' ],
            [ path: { "${params.outdir}/reads/host_only" }, mode: params.publish_dir_mode,
              pattern: '*.host.fq.gz', enabled: params.save_decontaminated_reads ]
        ]
    }
    withName: 'DECONTAM_LONG' {
        // original run: 32 cpus / 200 GB, 1 min
        cpus       = { 24 }
        memory     = { 96.GB * task.attempt }
        time       = { 12.h  * task.attempt }
        module     = { params.use_modules ? ['minimap2', 'seqkit'].collect { n -> params.mod[n] }.join(':') : '' }
        publishDir = [ path: { "${params.outdir}/decontam" }, mode: params.publish_dir_mode, saveAs: { fn -> fn.equals('versions.yml') ? null : fn } ]
    }
    withName: 'AUDIT_LONGREAD|AUDIT_LRFREE|AUDIT_DENOVO' {
        // original run: 32 cpus / 200 GB, 2-3 min
        cpus       = { 24 }
        memory     = { 96.GB * task.attempt }
        time       = { 12.h  * task.attempt }
        module     = { params.use_modules ? ['minimap2', 'seqkit'].collect { n -> params.mod[n] }.join(':') : '' }
        publishDir = [ path: { "${params.outdir}/decontam/audit" }, mode: params.publish_dir_mode, saveAs: { fn -> fn.equals('versions.yml') ? null : fn } ]
    }

    // ------------------------------------------------------------------ assembly
    withName: 'PBMM2_ALIGN' {
        // spliced alignment to a 405 MB genome
        cpus       = { 24 }
        memory     = { 96.GB * task.attempt }
        time       = { 12.h  * task.attempt }
        ext.args   = '--preset ISOSEQ --sort'
        ext.prefix = 'longreads_aligned'
        module     = { params.use_modules ? ['pbmm2', 'samtools'].collect { n -> params.mod[n] }.join(':') : '' }
        publishDir = [ enabled: false ]
    }
    withName: 'SAMTOOLS_FLAGSTAT' {
        cpus       = { 2 }
        memory     = { 4.GB * task.attempt }
        time       = { 2.h  * task.attempt }
        module     = { params.use_modules ? ['samtools'].collect { n -> params.mod[n] }.join(':') : '' }
        // the name the pre-nf-core layout used
        publishDir = [ path: { "${params.outdir}/assembly/isoseq" }, mode: params.publish_dir_mode,
                       saveAs: { fn -> fn.endsWith('.flagstat') ? 'longreads_aligned.flagstat.txt' : null } ]
    }
    withName: 'ISOSEQ_COLLAPSE' {
        // single-threaded collapse
        cpus       = { 8 }
        memory     = { 64.GB * task.attempt }
        time       = { 8.h   * task.attempt }
        module     = { params.use_modules ? ['isoseq', 'seqkit'].collect { n -> params.mod[n] }.join(':') : '' }
        publishDir = [ path: { "${params.outdir}/assembly/isoseq" }, mode: params.publish_dir_mode, saveAs: { fn -> fn.equals('versions.yml') ? null : fn } ]
    }
    withName: 'LONGREAD_GENOME_SEQ|FILTER_GTF_BY_IDS' {
        // gffread -w on ~64k models: seconds
        cpus       = { 2 }
        memory     = { 16.GB * task.attempt }
        time       = { 2.h   * task.attempt }
        module     = { params.use_modules ? ['seqkit'].collect { n -> params.mod[n] }.join(':') : '' }
        publishDir = [ path: { "${params.outdir}/assembly/isoseq" }, mode: params.publish_dir_mode, saveAs: { fn -> fn.equals('versions.yml') ? null : fn } ]
    }
    withName: 'STAR_ALIGN' {
        // measured 6-32 min at exactly 16 cpus / 64 GB.
        // 2-pass, no GTF in the index: junctions are discovered de novo.
        // --outSAMstrandField intronMotif also suppresses spliced alignments whose junctions are all
        // non-canonical and unannotated — conservative, but it drops a few genuine ones.
        cpus       = { 16 }
        memory     = { 64.GB * task.attempt }
        time       = { 12.h  * task.attempt }
        ext.args   = '--readFilesCommand zcat --outSAMtype BAM SortedByCoordinate --twopassMode Basic --outSAMstrandField intronMotif'
        module     = { params.use_modules ? ['star', 'samtools'].collect { n -> params.mod[n] }.join(':') : '' }
        publishDir = [ path: { "${params.outdir}/qc/star" }, mode: params.publish_dir_mode, pattern: '*.Log.final.out' ]
    }
    withName: 'STRINGTIE_STRINGTIE' {
        // per-sample assembly from one BAM; -l names the transcripts after the sample
        cpus       = { 8 }
        memory     = { 32.GB * task.attempt }
        time       = { 8.h   * task.attempt }
        ext.args   = {
            def strand = params.strandedness == 'reverse' ? '--rf' : (params.strandedness == 'forward' ? '--fr' : '')
            "${strand} -l ${meta.id}".trim()
        }
        module     = { params.use_modules ? ['stringtie', 'samtools'].collect { n -> params.mod[n] }.join(':') : '' }
        publishDir = [ path: { "${params.outdir}/assembly/stringtie" }, mode: params.publish_dir_mode,
                       saveAs: { fn -> fn.endsWith('.transcripts.gtf') ? fn.replace('.transcripts.gtf', '.gtf') : null } ]
    }
    withName: 'STRINGTIE_MERGE|GFFCOMPARE|STRINGTIE_NOVEL' {
        // original run: 24 cpus / 96-150 GB, 14 min for the three together
        cpus       = { 16 }
        memory     = { 64.GB * task.attempt }
        time       = { 12.h  * task.attempt }
        publishDir = [ path: { "${params.outdir}/assembly/stringtie" }, mode: params.publish_dir_mode, saveAs: { fn -> fn.equals('versions.yml') ? null : fn } ]
    }
    withName: 'STRINGTIE_MERGE' {
        ext.prefix = 'stringtie_merged'
        module     = { params.use_modules ? ['stringtie'].collect { n -> params.mod[n] }.join(':') : '' }
    }
    withName: 'GFFCOMPARE' {
        ext.prefix = 'gffcmp'
        // only the summary: the rest is an intermediate STRINGTIE_NOVEL selects from
        publishDir = [ path: { "${params.outdir}/assembly/stringtie" }, mode: params.publish_dir_mode, pattern: '*.stats' ]
        module     = { params.use_modules ? ['gffcompare'].collect { n -> params.mod[n] }.join(':') : '' }
    }
    withName: 'STRINGTIE_NOVEL' {
        module     = { params.use_modules ? ['seqkit'].collect { n -> params.mod[n] }.join(':') : '' }
    }
    withName: 'TRINITY' {
        // measured 9 h 18 m and 14 h 53 m at exactly 32 cpus / 250 GB; the module gives Trinity
        // 80% of task.memory as --max_memory (200G here)
        cpus       = { 32 }
        memory     = { 250.GB * task.attempt }
        time       = { 3.d    * task.attempt }
        ext.args   = {
            def ss = params.strandedness == 'reverse' ? '--SS_lib_type RF' : (params.strandedness == 'forward' ? '--SS_lib_type FR' : '')
            "${ss} --no_version_check".trim()
        }
        // trinity alone. The seqkit module ships its own Miniconda and prepends it to PATH, so
        // loading it after trinity hides trinity's python (the one that has numpy), and phase 2's
        // Trinity_gene_splice_modeler.py then dies with 'No module named numpy' hours in. The
        // nf-core module does not call seqkit, so it is not loaded at all.
        module     = { params.use_modules ? ['trinity'].collect { n -> params.mod[n] }.join(':') : '' }
        publishDir = [ path: { "${params.outdir}/assembly/denovo" }, mode: params.publish_dir_mode, pattern: '*.{fa.gz,log}' ]
    }
    withName: 'CLUSTER_LRFREE|CLUSTER_LRFREE_NR|CLUSTER_DENOVO|CLUSTER_LEAN' {
        // vsearch holds the sequences in memory; --strand both doubles the comparisons, and the
        // long-read set (553k sequences at id=0.99) is the slow one — measured well past an hour
        // on 12 cores for 120k sequences, so the ceiling is generous on purpose.
        //
        // vsearch rather than cd-hit-est: the identity definition is stated rather than implied
        // (cd-hit measures matches over the SHORTER sequence), and --query_cov puts a floor on how
        // much of a sequence must align before it is folded into a representative — cd-hit's -aS
        // equivalent, which this pipeline never set. --cluster_fast sorts by decreasing length, so
        // the representative is the longest member.
        cpus       = { 32 }
        memory     = { 200.GB * task.attempt }
        time       = { 2.d    * task.attempt }
        ext.args   = { "--id ${params.cdhit_dedup_id} --iddef 2 --query_cov ${params.cluster_min_cov} --strand both" }
        ext.args2  = '--cluster_fast'
        ext.args3  = '--centroids'
        module     = { params.use_modules ? ['vsearch'].collect { n -> params.mod[n] }.join(':') : '' }
        publishDir = [ enabled: false ]
    }
    withName: 'CLUSTER_LRFREE' {
        // Route B: collapse near-identical long-read isoforms
        ext.args   = { "--id ${params.cdhit_longread_id} --iddef 2 --query_cov ${params.cluster_min_cov} --strand both" }
    }
    withName: 'CLUSTER_LRFREE_NR' {
        // its input may be CLUSTER_LRFREE's <id>.centroids.fasta.gz: never write over the input
        ext.prefix = { "${meta.id}.nr" }
    }
    withName: 'NOVEL_DENOVO|NOVEL_LRFREE_A|NOVEL_LRFREE_B' {
        // Measured on this dataset (112,587 de novo transcripts vs the 78,879-transcript boosted
        // set), counting queries that pass the novelty rule of >=95% identity over >=90% coverage:
        //
        //   asm5        16,532 represented      (identical to asm10)
        //   asm10       16,532                  <- what this pipeline used
        //   asm20       22,145                  +5,613
        //   asm20 -c    31,623                  +15,091 over asm10
        //
        // Two separate effects, neither of them the divergence ceiling the preset names suggest:
        //  - asm5/asm10 seed with -w19, asm20 with -w10. Sparser minimizers miss true matches, so
        //    the ceiling is not what matters here; seeding density is.
        //  - without -c minimap2 reports APPROXIMATE residue matches from the chain, and the
        //    identity filter divides those. -c computes the real base-level alignment.
        // Every transcript wrongly called novel is added to the reference, and nothing downstream
        // can tell it apart from a real one. The exact alignment costs 4.4 s against 3.1 s.
        cpus       = { 32 }
        memory     = { 200.GB * task.attempt }
        time       = { 1.d    * task.attempt }
        ext.args   = '-x asm20 -c --secondary=no'
        module     = { params.use_modules ? ['minimap2', 'seqkit'].collect { n -> params.mod[n] }.join(':') : '' }
        publishDir = [ path: { "${params.outdir}/assembly/clustering" }, mode: params.publish_dir_mode, pattern: '*.log' ]
    }
    withName: 'SQANTI3_QC' {
        // structural classification against the short-read annotation; minimap2 under the hood
        cpus       = { 16 }
        memory     = { 64.GB * task.attempt }
        time       = { 12.h  * task.attempt }
        ext.args   = '--skipORF --report skip'
        module     = { params.use_modules ? ['sqanti3'].collect { n -> params.mod[n] }.join(':') : '' }
        publishDir = [ path: { "${params.outdir}/transcriptome/qc" }, mode: params.publish_dir_mode, saveAs: { fn -> fn.equals('versions.yml') ? null : fn } ]
    }
    withName: 'MERGE_ISOSEQ|MERGE_ISOSEQ_STRINGTIE|MERGE_WITH_TRINITY|MERGE_WITH_LRFREE|MERGE_ALL_SOURCES|MERGE_DEDUP|MAKE_TX2GENE|SUBSET_TX2GENE' {
        // cat and a single pass over FASTA headers
        cpus       = { 2 }
        memory     = { 16.GB * task.attempt }
        time       = { 4.h   * task.attempt }
        publishDir = [ path: { "${params.outdir}/transcriptome" }, mode: params.publish_dir_mode, saveAs: { fn -> fn.equals('versions.yml') ? null : fn } ]
    }
    withName: 'ROUTE_CONTRIBUTION' {
        // reads a handful of small tables
        cpus       = { 1 }
        memory     = { 8.GB * task.attempt }
        time       = { 1.h  * task.attempt }
        publishDir = [ path: { "${params.outdir}/transcriptome/qc" }, mode: params.publish_dir_mode, saveAs: { fn -> fn.equals('versions.yml') ? null : fn } ]
    }
    withName: 'BUSCO_RENAME' {
        // serial ids >t1, >t2, ...: see subworkflows/local/transcriptome_busco
        cpus       = { 1 }
        memory     = { 4.GB * task.attempt }
        time       = { 1.h  * task.attempt }
        ext.args   = "-p '.+' -r 't{nr}'"
        // not ${meta.id}: the input is <id>.fasta, and seqkit would write over its own input
        ext.prefix = { "${meta.id}.serial" }
        module     = { params.use_modules ? ['seqkit'].collect { n -> params.mod[n] }.join(':') : '' }
        publishDir = [ enabled: false ]
    }
    withName: 'BUSCO_BUSCO' {
        // measured 1-73 min at exactly 24 cpus / 64 GB. A failed BUSCO reports NA, not a dead run.
        cpus          = { 24 }
        memory        = { 64.GB * task.attempt }
        time          = { 1.d   * task.attempt }
        errorStrategy = 'ignore'
        // a PYTHONPATH inherited from the launching shell breaks BUSCO's own interpreter.
        // The nf-core module reads AUGUSTUS_CONFIG_PATH under `set -u`; containers set it, an
        // environment module may not. Transcriptome mode never runs Augustus, so any writable
        // directory will do -- the task's own.
        beforeScript  = { params.use_modules
                              ? 'unset PYTHONPATH; export AUGUSTUS_CONFIG_PATH="${AUGUSTUS_CONFIG_PATH:-$PWD}"'
                              : 'unset PYTHONPATH' }
        module     = { params.use_modules ? ['busco'].collect { n -> params.mod[n] }.join(':') : '' }
        publishDir    = [ path: { "${params.outdir}/transcriptome/qc" }, mode: params.publish_dir_mode, pattern: '{short_summary.*,*-busco.batch_summary.txt}' ]
    }
    withName: 'BUSCO_SUMMARY' {
        cpus       = { 1 }
        memory     = { 2.GB * task.attempt }
        time       = { 1.h  * task.attempt }
        publishDir = [ path: { "${params.outdir}/transcriptome/qc" }, mode: params.publish_dir_mode, saveAs: { fn -> fn.equals('versions.yml') ? null : fn } ]
    }

    // ------------------------------------------------------------------ annotation
    withName: 'TRANSDECODER_LONGORF|TRANSDECODER_PREDICT' {
        // measured 5 min at 16 cpus / 64 GB
        cpus       = { 16 }
        memory     = { 48.GB * task.attempt }
        time       = { 12.h  * task.attempt }
        module     = { params.use_modules ? ['seqkit'].collect { n -> params.mod[n] }.join(':') : '' }
        publishDir = [ enabled: false ]
    }
    withName: 'TRANSDECODER_PREDICT' {
        ext.args   = '--single_best_only --no_refine_starts'
        // <set>.pep / <set>.cds / <set>.transdecoder.gff3, as before the nf-core modules
        publishDir = [ path: { "${params.outdir}/annotation" }, mode: params.publish_dir_mode,
                       saveAs: { fn ->
                           def m = fn =~ /^(.+?)\.(fasta|fa|fna)(\.gz)?\.transdecoder\.(pep|cds|gff3|bed)$/
                           !m ? null : (m[0][4] in ['pep', 'cds'] ? "${m[0][1]}.${m[0][4]}" : "${m[0][1]}.transdecoder.${m[0][4]}")
                       } ]
    }
    withName: 'CLEAN_PEP' {
        // one sed pass
        cpus       = { 1 }
        memory     = { 8.GB * task.attempt }
        time       = { 2.h  * task.attempt }
        publishDir = [ enabled: false ]
    }
    withName: 'DIAMOND_BLASTP' {
        // original run: 24 cpus / 120 GB for both databases, ~30 min
        cpus       = { 24 }
        memory     = { 96.GB * task.attempt }
        time       = { 12.h  * task.attempt }
        ext.args   = '-k 1 -e 1e-5 --more-sensitive --quiet'
        ext.prefix = { "diamond_${meta2.id}" }
        module     = { params.use_modules ? ['diamond'].collect { n -> params.mod[n] }.join(':') : '' }
        // published as .tsv, the name the pre-nf-core layout used (the module writes .txt for outfmt 6)
        publishDir = [ path: { "${params.outdir}/annotation/diamond" }, mode: params.publish_dir_mode,
                       saveAs: { fn -> fn.endsWith('.txt') ? fn.replaceAll(/\.txt$/, '.tsv') : null } ]
    }
    withName: 'EGGNOGMAPPER' {
        // diamond mode; the 9 GB database is memory-mapped, not loaded
        cpus       = { 24 }
        memory     = { 96.GB * task.attempt }
        time       = { 1.d   * task.attempt }
        ext.args   = '--override'
        ext.prefix = 'eggnog'
        module     = { params.use_modules ? ['eggnog'].collect { n -> params.mod[n] }.join(':') : '' }
        publishDir = [ path: { "${params.outdir}/annotation/eggnog" }, mode: params.publish_dir_mode ]
    }
    withName: 'INTERPROSCAN' {
        // measured 45-76 min at 32 cpus / 96-200 GB
        cpus       = { 32 }
        memory     = { 96.GB * task.attempt }
        time       = { 2.d   * task.attempt }
        ext.args   = { "-f tsv -appl ${params.interproscan_appl} -dp -goterms" }
        ext.prefix = 'interpro'
        module     = { params.use_modules ? ['interproscan'].collect { n -> params.mod[n] }.join(':') : '' }
        publishDir = [ path: { "${params.outdir}/annotation/interproscan" }, mode: params.publish_dir_mode, pattern: '*.tsv' ]
    }
    withName: 'INTEGRATE_ANNOTATION' {
        // joins the search outputs in memory
        cpus       = { 4 }
        memory     = { 32.GB * task.attempt }
        time       = { 4.h   * task.attempt }
        publishDir = [ path: { "${params.outdir}/annotation" }, mode: params.publish_dir_mode, saveAs: { fn -> fn.equals('versions.yml') ? null : fn } ]
    }

    // ------------------------------------------------------------------ quantification / DGE
    withName: 'SALMON_INDEX|SALMON_INDEX_PRE' {
        // measured 1-2 min; decoy-aware index of a 3.6 Gb gentrome
        cpus       = { 16 }
        memory     = { 64.GB * task.attempt }
        time       = { 8.h   * task.attempt }
        ext.args   = '-k 31'
        module     = { params.use_modules ? ['salmon'].collect { n -> params.mod[n] }.join(':') : '' }
        publishDir = [ enabled: false ]
    }
    withName: 'SALMON_QUANT|SALMON_QUANT_PRE' {
        // measured 2-6 min at exactly 12 cpus / 32 GB. A fixed 12, not a scaled value: the thread
        // count does not affect reproducibility (see below), but it should still be a property of
        // the pipeline, not of the host.
        cpus       = { 12 }
        memory     = { 32.GB * task.attempt }
        time       = { 8.h   * task.attempt }
        // -l A auto-detects the library type; SALMON_LIBTYPE_CHECK then checks the detection
        // against --strandedness. --dumpEq writes the fragment equivalence classes Corset
        // clusters on; --numBootstraps gives inferential replicates, which is what tells you a
        // gene's signal rests on reads that several near-duplicate transcripts could equally claim.
        //
        // REPRODUCIBILITY. salmon 1.10.0 has no --seed, and no setting here makes quant.sf
        // byte-reproducible. Measured on S01_Control_B, sum|delta NumReads| between runs:
        //   same args, same -p 12 (5 reps, 10 pairs)  8,300-13,900 of 10.6 M mapped fragments
        //   -p 12 vs -p 8 vs -p 1                     ~10,000-13,000  (thread count is irrelevant;
        //                                              -p 1 costs 11 min/sample and buys nothing)
        //   --initUniform                             34,000-42,000   (changes the answer, no fix)
        //   raised --numAuxModelSamples/--numBiasSamples  BIMODAL and much worse: 5 reps split into
        //                                              two basins, ~4,000-5,600 within a basin but
        //                                              ~113,000 between, at 0.71 relative TPM error
        //                                              on the top 1% of transcripts. Which basin a
        //                                              run lands in is a coin flip. Do not use.
        //   no --gcBias --seqBias                     ~1,300          (8x quieter, but the bias
        //                                              models move 1.5-2.3 M reads, so dropping
        //                                              them trades a real correction for tidiness)
        // The source is the online phase: equivalence classes are stable to 69 reads in 10.6 M,
        // but a ~3-read mapping difference perturbs the streaming fragment-length/bias models and
        // thence ~31 k effective lengths. Downstream cost, measured end-to-end by requantifying
        // all 15 samples twice and re-running DESeq2: 0-3 of ~125-143 significant genes move
        // (Jaccard 0.975-1.000) and every mover sits at the padj or |LFC| boundary. Corset's own
        // count matrix is 4-6x WORSE on the same test (Jaccard 0.904/0.905), because it re-runs
        // its own EM and re-derives the clustering on top.
        // So: keep the bias corrections, treat published quant.sf files as the record of a run
        // rather than something a re-run will reproduce exactly.
        // --validateMappings dropped: deprecated in salmon 1.10, which reports it as having no
        // effect because selective alignment is already the default.
        ext.args   = '-l A --gcBias --seqBias --dumpEq --numBootstraps 30'
        module     = { params.use_modules ? ['salmon'].collect { n -> params.mod[n] }.join(':') : '' }
        publishDir = [ path: { "${params.outdir}/quantification" }, mode: params.publish_dir_mode,
                       saveAs: { fn -> (fn.equals('versions.yml') || fn.endsWith('.json')) ? null : fn } ]
    }
    withName: 'SALMON_QUANT_PRE' {
        // The pre-filter pass exists only to produce TPMs for FILTER_BY_EXPRESSION: it is run on
        // the unfiltered ladder tip, nothing downstream reads it, and publishing it would put a
        // second quant.sf per sample in quantification/ that no reported number comes from.
        // Everything else (resources, args, module) comes from the selector above.
        publishDir = [ enabled: false ]
    }
    withName: 'SALMON_LIBTYPE_CHECK|SALMON_LIBTYPE_CHECK_PRE' {
        cpus       = { 1 }
        memory     = { 2.GB * task.attempt }
        time       = { 1.h  * task.attempt }
        publishDir = [ enabled: false ]
    }
    withName: 'FILTER_BY_EXPRESSION' {
        // one pass over 15 quant.sf files
        cpus       = { 2 }
        memory     = { 16.GB * task.attempt }
        time       = { 2.h   * task.attempt }
        publishDir = [ path: { "${params.outdir}/transcriptome" }, mode: params.publish_dir_mode, saveAs: { fn -> fn.equals('versions.yml') ? null : fn } ]
    }
    withName: 'CORSET' {
        cpus       = { 4 }
        memory     = { 64.GB * task.attempt }
        time       = { 12.h  * task.attempt }
        // No -D: corset's default (17.5 + 2.5*ndf, p ~ 1e-5) keeps its likelihood-ratio test,
        // which splits read-sharing contigs whose expression profiles cannot belong to one gene.
        // Disabling it (the -D 99999999 used until now, equivalent to corset's -I, which its
        // documentation scopes to DTU rather than DE) merged ~5,100 genes away: 33,533 clusters
        // against 38,670 at the default, measured on the same equivalence classes.
        //
        // -x bounds how promiscuous a read may be before it is ignored for clustering. Measured
        // on this dataset: 43% of equivalence classes name one contig, 96% name <= 25, and the
        // largest names 86 — so 25 keeps almost everything while dropping the 4% that chain
        // otherwise-unrelated contigs into one component. Without it corset builds a single
        // 3,285-transcript cluster and spends hours inside it.
        ext.args   = '-x 25'
        // The gene map goes beside the string-stripped and locus maps in transcriptome/, so all
        // three tx2gene.<label>.tsv files sit in one folder; corset's own output stays here.
        publishDir = [
            [ path: { "${params.outdir}/quantification" }, mode: params.publish_dir_mode,
              saveAs: { fn -> (fn.equals('versions.yml') || fn.startsWith('tx2gene.')) ? null : fn } ],
            [ path: { "${params.outdir}/transcriptome" }, mode: params.publish_dir_mode,
              saveAs: { fn -> fn.startsWith('tx2gene.') ? fn : null } ]
        ]
    }
    withName: 'GENE_FASTA|GENE_FASTA_LOCUS|GENE_FASTA_CORSET' {
        // one sequence per gene, beside the tx2gene map that defines the genes
        publishDir = [ path: { "${params.outdir}/transcriptome" }, mode: params.publish_dir_mode, saveAs: { fn -> fn.equals('versions.yml') ? null : fn } ]
    }
    withName: 'REMAP_ANNOTATION' {
        // the Corset map's re-keyed annotation, beside the other two maps' annotation.<label>.tsv
        publishDir = [ path: { "${params.outdir}/transcriptome" }, mode: params.publish_dir_mode, saveAs: { fn -> fn.equals('versions.yml') ? null : fn } ]
    }
    withName: 'QUANT_SUMMARY' {
        // reads 15 small JSON files
        cpus       = { 1 }
        memory     = { 8.GB * task.attempt }
        time       = { 1.h  * task.attempt }
        publishDir = [ path: { "${params.outdir}/quantification" }, mode: params.publish_dir_mode, saveAs: { fn -> fn.equals('versions.yml') ? null : fn } ]
    }
    withName: 'DESEQ2|DESEQ2_LOCUS|DESEQ2_CORSET' {
        // measured 1-2 min at 16 cpus / 120 GB; single-threaded. The locus and corset arms are the
        // same quantifications re-aggregated under a different gene map.
        cpus       = { 8 }
        memory     = { 48.GB * task.attempt }
        time       = { 8.h   * task.attempt }
        module     = { params.use_modules ? ['r'].collect { n -> params.mod[n] }.join(':') : '' }
    }
    withName: 'DESEQ2' {
        publishDir = [ path: { "${params.outdir}/dge" }, mode: params.publish_dir_mode, saveAs: { fn -> fn.equals('versions.yml') ? null : fn } ]
    }
    withName: 'DESEQ2_LOCUS' {
        publishDir = [ path: { "${params.outdir}/dge_locus" }, mode: params.publish_dir_mode, saveAs: { fn -> fn.equals('versions.yml') ? null : fn } ]
    }
    withName: 'DESEQ2_CORSET' {
        publishDir = [ path: { "${params.outdir}/dge_corset" }, mode: params.publish_dir_mode, saveAs: { fn -> fn.equals('versions.yml') ? null : fn } ]
    }
    withName: 'ENRICHMENT|ENRICHMENT_LOCUS|ENRICHMENT_CORSET' {
        // GSEA dominates the runtime, ~10 min per contrast
        cpus       = { 8 }
        memory     = { 48.GB * task.attempt }
        time       = { 12.h  * task.attempt }
        module     = { params.use_modules ? ['r'].collect { n -> params.mod[n] }.join(':') : '' }
    }
    withName: 'ENRICHMENT' {
        publishDir = [ path: { "${params.outdir}/enrichment" }, mode: params.publish_dir_mode, saveAs: { fn -> fn.equals('versions.yml') ? null : fn } ]
    }
    withName: 'ENRICHMENT_LOCUS' {
        publishDir = [ path: { "${params.outdir}/enrichment_locus" }, mode: params.publish_dir_mode, saveAs: { fn -> fn.equals('versions.yml') ? null : fn } ]
    }
    withName: 'ENRICHMENT_CORSET' {
        publishDir = [ path: { "${params.outdir}/enrichment_corset" }, mode: params.publish_dir_mode, saveAs: { fn -> fn.equals('versions.yml') ? null : fn } ]
    }
    withName: 'ISOFORM_SWITCHING' {
        // IsoformSwitchAnalyzeR holds the whole switchlist in memory
        cpus       = { 16 }
        memory     = { 96.GB * task.attempt }
        time       = { 1.d   * task.attempt }
        module     = { params.use_modules ? ['r'].collect { n -> params.mod[n] }.join(':') : '' }
        publishDir = [ path: { "${params.outdir}/isoforms" }, mode: params.publish_dir_mode, saveAs: { fn -> fn.equals('versions.yml') ? null : fn } ]
    }
    withName: 'LOCUS_TX2GENE' {
        // minimap2 -x splice of every transcript, then bedtools
        cpus       = { 16 }
        memory     = { 64.GB * task.attempt }
        time       = { 12.h  * task.attempt }
        module     = { params.use_modules ? ['minimap2', 'bedtools', 'seqkit'].collect { n -> params.mod[n] }.join(':') : '' }
        publishDir = [ path: { "${params.outdir}/transcriptome" }, mode: params.publish_dir_mode, saveAs: { fn -> fn.equals('versions.yml') ? null : fn } ]
    }

    // ------------------------------------------------------------------ reporting
    withName: 'AGGREGATE_TSV|AGGREGATE_ASSEMBLY_READS|DECONTAM_MQC' {
        // concatenates small tables
        cpus       = { 1 }
        memory     = { 8.GB * task.attempt }
        time       = { 1.h  * task.attempt }
        publishDir = [ path: { "${params.outdir}/qc" }, mode: params.publish_dir_mode, saveAs: { fn -> fn.equals('versions.yml') ? null : fn } ]
    }
    withName: 'MULTIQC' {
        // parses the QC reports
        cpus       = { 4 }
        memory     = { 32.GB * task.attempt }
        time       = { 6.h   * task.attempt }
        ext.args   = { params.multiqc_title ? "--title \"$params.multiqc_title\"" : '' }
        module     = { params.use_modules ? ['multiqc'].collect { n -> params.mod[n] }.join(':') : '' }
        publishDir = [ path: { "${params.outdir}/qc/multiqc" }, mode: params.publish_dir_mode ]
    }
    withName: 'FIGURES' {
        // ggplot over the DE tables
        cpus       = { 8 }
        memory     = { 48.GB * task.attempt }
        time       = { 6.h   * task.attempt }
        module     = { params.use_modules ? ['r'].collect { n -> params.mod[n] }.join(':') : '' }
        publishDir = [ path: { "${params.outdir}" }, mode: params.publish_dir_mode, saveAs: { fn -> fn.equals('versions.yml') ? null : fn } ]
    }
    withName: 'DASHBOARD' {
        // reads the annotation table and the DE results
        cpus       = { 2 }
        memory     = { 16.GB * task.attempt }
        time       = { 4.h   * task.attempt }
        publishDir = [ path: { "${params.outdir}" }, mode: params.publish_dir_mode, saveAs: { fn -> fn.equals('versions.yml') ? null : fn } ]
    }
    withName: 'RUN_SUMMARY' {
        // reads the summary tables
        cpus       = { 1 }
        memory     = { 8.GB * task.attempt }
        time       = { 1.h  * task.attempt }
        publishDir = [ path: { "${params.outdir}" }, mode: params.publish_dir_mode, saveAs: { fn -> fn.equals('versions.yml') ? null : fn } ]
    }
}
