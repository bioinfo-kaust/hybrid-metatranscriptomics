/*
 * Minimal profile for validating the workflow's plumbing, not its biology.
 *
 *   nextflow run . -profile test -stub-run
 *
 * Every process is replaced by its `stub` block, so the whole DAG — the fan-outs,
 * the joins and the ladder — runs in seconds on a laptop with no tools installed. Use it after
 * any change to channels or process signatures, before committing to a real run.
 */

params {
    config_profile_name        = 'Test profile'
    config_profile_description = 'Tiny fixtures to check the DAG; run with -stub-run'

    skip_eggnog       = true      // needs a multi-GB local database
    skip_interproscan = true      // hours, even on real data
    publish_dir_mode  = 'copy'

    // Tiny fixtures (assets/test, ~20 kB): 3 conditions x 2 replicates, one two-lane sample, one
    // assembly-only library, five long reads and a 2 kb genome. The samplesheet paths are relative,
    // so launch from the repository root. A -params-file replaces these.
    input           = "${projectDir}/assets/test/samplesheet_short.csv"
    longread_input  = "${projectDir}/assets/test/samplesheet_long.csv"
    assembly_input  = "${projectDir}/assets/test/samplesheet_assembly.csv"
    genome          = "${projectDir}/assets/test/genome.fa"
    reference_level = 'Control'
}

process {
    resourceLimits = [ cpus: 2, memory: '6.GB', time: '1.h' ]
}
