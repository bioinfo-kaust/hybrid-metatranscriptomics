/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    bioinfo-kaust/hybrid-metatranscriptomics Nextflow config file
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Host-only transcriptome reconstruction from long + short reads, with symbiont/contaminant
    reads removed before assembly, then annotation, quantification and differential expression.

    Every value below is a parameter with a generic default. A dataset is described by a
    -params-file (assets/params_cassiopea_uv.yml for the Cassiopea andromeda UV experiment), and
    site paths (reads, staged references, databases, outdir, account) by a config passed with -c.

    Usage:
      nextflow run . -profile singularity -params-file my.yml --outdir results    # containers
      nextflow run . -profile hpc,envmodules -params-file my.yml --outdir results # environment modules
      nextflow run . -profile test,singularity --outdir results                   # small real test
      nextflow run . -profile test -stub-run --outdir results                     # plumbing check
----------------------------------------------------------------------------------------
*/

// Global default params, used in configs
params {

    // ------------------------------------------------------------------ input
    input                = null          // sample,condition,replicate,fastq_1,fastq_2  (>1 row per sample = lanes, merged)
    longread_input       = null          // sample,condition,reads (fasta/fastq[.gz]); null disables the long-read side
    // Long reads that were pooled before the pipeline saw them (a polished Iso-Seq set, say) carry
    // no per-sample identity. Point this at a 'sequence_id<TAB>sample' table to recover it —
    // extra/pacbio_fl_counts_to_membership.py builds one from a PacBio FL count matrix.
    longread_membership  = null
    // Extra short-read libraries used ONLY to assemble the reference (StringTie + Trinity): same
    // preprocessing as --input, never quantified or tested. For public libraries of the same
    // species that assemble better than the experiment's own. Same columns as `input`; the
    // condition column may be empty. Their strandedness must match `strandedness`. null = none.
    assembly_input       = null

    // ------------------------------------------------------- reference genome
    // Give a local FASTA, or an NCBI accession to download with `datasets`. Optional: with neither,
    // the genome-guided routes, SQANTI3 and the locus gene map are skipped, salmon runs without
    // decoys, and decontamination removes every read that places on a contaminant.
    genome               = null
    genome_accession     = null
    genome_name          = 'host_genome'
    star_index           = null          // prebuilt STAR index dir; built when null

    // --------------------------------------------- contaminant / symbiont set
    // Genomes whose reads must be removed BEFORE assembly. Any one of:
    //   contaminant_fasta       - a single (already combined) FASTA
    //   contaminant_dir         - a directory of FASTA files, concatenated by the pipeline
    //   contaminant_accessions  - comma-separated NCBI accessions, downloaded and concatenated
    // All three null = decontamination is skipped (same as --skip_decontam).
    contaminant_fasta      = null
    contaminant_dir        = null
    contaminant_accessions = null
    contaminant_prefix     = 'CONTAM_'   // scaffold-name prefix that marks contaminant sequence
    contaminant_margin     = 1.1         // best-residue-match margin for the long-read classifier
    keep_ambiguous_long    = false       // false = drop 'ambiguous' long reads (project behaviour)

    // ---------------------------------------------------------- rRNA database
    rrna_fasta   = null                  // local FASTA; downloaded from rrna_db_urls when null
    rrna_db_base = 'https://raw.githubusercontent.com/sortmerna/sortmerna/master/data/rRNA_databases'
    rrna_db_sets = 'silva-arc-16s-id95,silva-arc-23s-id98,silva-bac-16s-id90,silva-bac-23s-id98,silva-euk-18s-id95,silva-euk-28s-id98,rfam-5s-database-id98,rfam-5.8s-database-id98'
    rrna_kmer    = 31

    // ------------------------------------------------------- annotation databases
    diamond_db_dir  = null               // dir with prebuilt <name>.dmnd files; built when null
    // Which DIAMOND database supplies the generic protein_hit / protein_desc columns that the
    // locus validation, the figures, the dashboard and the interest regex all key on. Without
    // this the integrator falls back to alphabetical order, which silently promoted the small
    // specialist DB (toxprot, 1,021 hits) over Swiss-Prot (28,059).
    primary_protein_db = 'uniprot_sprot'
    swissprot_url   = 'https://ftp.uniprot.org/pub/databases/uniprot/current_release/knowledgebase/complete/uniprot_sprot.fasta.gz'
    // Second (specialist) DIAMOND DB. Default = UniProt Tox-Prot (reviewed animal toxins).
    // Set specialist_url = null to run with Swiss-Prot only.
    specialist_name = 'toxprot'
    specialist_url  = 'https://rest.uniprot.org/uniprotkb/stream?query=%28keyword%3AKW-0800%29%20AND%20%28reviewed%3Atrue%29&format=fasta&compressed=true'
    eggnog_data_dir = null               // required unless skip_eggnog
    interproscan_appl = 'Pfam,SMART,SUPERFAMILY,CDD,PRINTS'
    interproscan_db   = null             // InterProScan data/ directory; null = the installation's own
    // Regex flagging a gene family of interest in the annotation table (column of_interest).
    // Word boundaries on the short tokens: a bare 'UV' matched as a substring collects
    // "pyruvate" and "recurvature", and a bare 'MAA' collects any word containing it.
    interest_regex  = 'photolyase|mycosporine|\\bMAA\\b|superoxide dismutase|catalase|peroxiredoxin|heat shock|HSP\\d|opsin|photorecept|DNA repair|nucleotide excision|thioredoxin|glutathione|\\bUV\\b|\\bUV-|ultraviolet|cryptochrome'
    interest_label  = 'UV_stress_family'

    // ---------------------------------------------------------------- BUSCO
    busco_lineage       = 'cnidaria_odb12'
    busco_download_path = null           // reuse an existing BUSCO lineage cache
    busco_mode          = 'transcriptome'

    // ------------------------------------------------- experimental design
    condition_column = 'condition'
    reference_level  = null              // e.g. 'Control'; first level alphabetically when null
    design           = '~ condition'
    contrasts        = "${projectDir}/assets/contrasts.csv"   // id,factor,level,reference; null = every level vs reference_level
    strandedness     = 'reverse'         // reverse | forward | unstranded
    // salmon detects the library type per sample with -l A; when true, a detection that disagrees
    // with `strandedness` fails that sample instead of being printed and forgotten
    strandedness_check = true
    min_mapping_rate   = 70              // fail the run if any library maps below this percentage
    random_seed      = 42                // GSEA's multilevel algorithm is randomised; fix it

    // ------------------------------------------------ statistics: one source of truth
    // deseq2.R, enrichment.R and figures.R all read these, so a threshold changed here moves
    // the tables, the enrichment and the figure captions together instead of one of the three.
    de_min_count   = 5                   // a gene needs >= this many counts ...
    de_min_samples = 3                   // ... in at least this many libraries to be tested
    de_alpha       = 0.05                // adjusted-p cutoff, everywhere
    de_lfc         = 1                   // |log2FC| cut applied when counting up/down
    // Fold-change shrinkage for reporting and ranking: apeglm where the contrast is a model
    // coefficient, ashr for the rest (apeglm cannot take an arbitrary contrast). 'none' restores
    // the raw MLE fold changes. The unshrunken value is kept in its own column either way.
    de_shrink      = 'apeglm'            // apeglm | ashr | normal | none

    // ---------------------------------------------- transcriptome assembly knobs
    min_transcript_len   = 300           // minimum length of a novel transcript added to the reference
    cdhit_longread_id    = 0.99          // Route B: collapse near-identical long-read isoforms
    cdhit_dedup_id       = 0.95          // cross-source dedup / de novo isoform collapse
    // Clustering is vsearch, novelty is minimap2 (cd-hit-est / -est-2d until v2). Both thresholds
    // below are the coverage floors those tools make explicit and cd-hit left implicit.
    cluster_min_cov      = 0.9           // fraction of a sequence that must align to its representative
    novelty_min_cov      = 0.9           // ... and to a reference transcript before it counts as known
    stringtie_class_codes = 'u|x|i|y'    // gffcompare class codes kept as novel loci
    // Route A sequences from the GENOME at the collapsed models' exon coordinates (gffread -w)
    // instead of the Iso-Seq consensus. The HQ consensus carries homopolymer indels (1.26
    // frameshifts/kb against the genome on this project) that break ORFs: the same models with
    // genome bases scored CDS BUSCO 71.3% against 68.2%. Identical to SQANTI3's *_corrected.fasta.
    // false keeps the consensus (a genome of a different strain/population than the reads, say).
    longread_genome_sequence = true
    // which ladder rung feeds quantification. Names read as the sources they contain, in the
    // order they were layered:
    //   isoseq                           Iso-Seq models collapsed on the genome (route A)
    //   isoseq_stringtie                 + genome-guided short-read loci the long reads missed
    //   isoseq_stringtie_trinity         + de novo loci absent from the draft genome
    //   isoseq_stringtie_lrfree          + reference-free long-read loci, no Trinity
    //   isoseq_stringtie_trinity_lrfree  all four sources merged
    //   all_sources_dedup                after cross-source deduplication (vsearch, 95%)
    // The expression filter below then derives all_sources_dedup_expressed from the rung named
    // here, and THAT is what is annotated, quantified and tested.
    dge_reference        = 'all_sources_dedup'
    // Prefixes marking where a transcript came from (kept in every downstream table).
    prefix_stringtie = 'ST_'    // genome-guided short-read assembly
    prefix_denovo    = 'TR_'    // de novo short-read assembly
    prefix_lrfree    = 'PBR_'   // reference-free long-read set
    // Per-source transcript -> gene rules: 'prefix:isoform_suffix_regex', ';'-separated, first
    // match wins, empty regex = no grouping (gene == transcript). Used for the string-stripped
    // tx2gene map; the locus rebuild below is the coordinate-based alternative.
    tx2gene_rules = 'TR_:_i[0-9]+$;PBR_:;:\\.[0-9]+$'

    // ------------------------------------------- expression filter: the analysed set
    // The ladder applies no expression evidence at any rung, so its tip is a cross-source union
    // carrying every near-duplicate and every unexpressed fragment. One salmon pass over that tip
    // decides what the experiment actually saw, and the survivors become the ANALYSED set: they
    // are what gets annotated, re-quantified, tested, enriched and plotted. 0 disables the filter,
    // and the ladder tip itself is analysed instead (one salmon pass either way).
    //
    // What the filter does not touch is the assembly. Every rung keeps its own FASTA, seqkit stats
    // and BUSCO summary, so the transcript count and the completeness quoted for the transcriptome
    // stay properties of the full deduplicated set -- and the filtered set gets the same two
    // measurements, so the two can be read side by side (measured here: expression only gives the
    // highest single-copy BUSCO fraction of any reference in the ladder).
    //
    // There is deliberately no second route in. An earlier version of this pipeline annotated the
    // unfiltered tip and could rescue a transcript on ORF + homology support; measured on this
    // dataset that bought 0 DE genes and +0.127 pts of mapping rate (spread evenly over all 15
    // libraries, so it cannot move a contrast) while making the reference worse where it counts:
    // 56,599 tx at C:72.1% S:45.5% D:26.6% with the rescue against 48,224 tx at C:70.6% S:48.2%
    // D:22.4% without -- 48 more complete markers for 144 more duplicated ones.
    expr_filter_tpm      = 1             // TPM a transcript must reach ...
    expr_filter_reads    = 0             // ... and/or estimated reads (salmon NumReads); 0 = off
    expr_filter_samples  = 3             // ... in at least this many libraries

    // ---------------------------------------------- locus-based gene rebuild
    // Three gene maps are produced (string-stripped ids, genomic loci, Corset read sharing) and
    // none is unambiguously right. This names the one the headline numbers come from; the others
    // stay published as sensitivity analyses rather than as three equal answers.
    dge_primary_map   = 'locus'          // string | locus | corset; the other two are still
                                         // built and published as sensitivity arms
    run_locus_rebuild = true
    locus_groupby     = 'junction'       // junction | exon
    locus_mincov      = 0.9              // min fraction of a transcript that must align to the genome;
                                         // matches cluster_min_cov / novelty_min_cov so one coverage
                                         // rule decides "this transcript is represented" everywhere
    locus_se_overlap  = 0.5              // junction mode: single-exon attach threshold

    // ------------------------------------------------------------ step toggles
    skip_fastp        = false
    skip_rrna         = false
    skip_decontam     = false
    skip_longread     = false
    skip_genome_guided = false           // Route A (long reads on the genome)
    skip_reffree      = false            // Route B (reference-free long-read collapse)
    skip_stringtie    = false            // genome-guided short-read assembly + merge
    skip_denovo       = false            // Trinity
    skip_annotation   = false
    skip_eggnog       = false
    skip_interproscan = false
    skip_dge          = false
    skip_enrichment   = false
    skip_dtu          = true             // differential isoform usage (see README caveat)
    skip_busco        = false
    skip_sqanti       = false           // SQANTI3 structural QC of the long-read models
    skip_corset       = false           // gene map from salmon equivalence classes
    corset_use_groups = false           // true passes -g <condition>: circular for DE (gene splits use the tested labels)
    skip_figures      = false
    skip_multiqc      = false
    skip_dashboard    = false
    dashboard_title   = null            // heading on the dashboard; defaults to the reference set
    save_decontaminated_reads = false   // publish the host-only FASTQs (large)

    // ---------------------------------------------------------- environment
    // Tool provisioning without containers or conda: -profile envmodules sets use_modules, and
    // conf/modules.config attaches these module names per process (`module load`). Containers
    // (-profile docker/singularity/...) and conda/mamba need none of this.
    use_modules      = false             // -profile envmodules

    mod = [                              // environment-module names; override e.g. --mod.star star/2.7.11b
        datasets     : 'ncbi_datasets_tools/16',
        seqkit       : 'seqkit/2.10.1',
        samtools     : 'samtools/1.16.1',
        minimap2     : 'minimap2/2.24',
        bbtools      : 'bbtools/37.62',
        fastp        : 'fastp/0.23.2',
        fastqc       : 'fastqc/0.12.0',
        multiqc      : 'multiqc/1.28',
        star         : 'star/2.7.10b',
        stringtie    : 'stringtie/2.2.1',
        gffcompare   : 'gffcompare/0.12.7',
        pbmm2        : 'pbmm2/1.17.0',
        isoseq       : 'isoseq/4.0.0',
        cdhit        : 'cdhit/4.8.1',
        vsearch      : 'vsearch/2.22.1',
        sqanti3      : 'sqanti3/4.0',
        trinity      : 'trinity/2.15.1',
        salmon       : 'salmon/1.10.0',
        busco        : 'busco/5.8.3',
        diamond      : 'diamond/2.1.16',
        eggnog       : 'eggnog-mapper/2.1.12',
        interproscan : 'interproscan/5.61-93.0',
        blast        : 'blast/2.16.0',
        bedtools     : 'bedtools/2.30.0',
        r            : 'bioconductor/3.19/R-4.4.0'
    ]

    // corset has no environment module here; point this at a bin/ that provides it
    corset_bin       = null
    // Extra R library path (DESeq2, apeglm, clusterProfiler, ...) for -profile envmodules. The
    // bioconductor module has no apeglm, so without it shrinkage silently degrades to ashr. Never
    // set it with containers: a host library would shadow the container's packages.
    r_libs           = null
    genemap_eval     = null            // dir of externally-computed gene-map evaluation tables
    extra_path       = null              // prepended to PATH for TransDecoder, gffread (envmodules)

    // ------------------------------------------------------------------ MultiQC
    multiqc_config              = null
    multiqc_title               = null
    multiqc_logo                = null
    max_multiqc_email_size      = '25.MB'
    multiqc_methods_description = null

    // ------------------------------------------------------------------ boilerplate
    outdir                       = null
    publish_dir_mode             = 'copy'
    email                        = null
    email_on_fail                = null
    plaintext_email              = false
    monochrome_logs              = false
    help                         = false
    help_full                    = false
    show_hidden                  = false
    version                      = false
    pipelines_testdata_base_path = 'https://raw.githubusercontent.com/nf-core/test-datasets/'
    trace_report_suffix          = new java.util.Date().format( 'yyyy-MM-dd_HH-mm-ss')

    // ------------------------------------------------------------------ institutional configs
    config_profile_name        = null
    config_profile_description = null
    custom_config_version      = 'master'
    custom_config_base         = "https://raw.githubusercontent.com/nf-core/configs/${params.custom_config_version}"
    config_profile_contact     = null
    config_profile_url         = null

    // ------------------------------------------------------------------ schema validation
    validate_params            = true

    // ------------------------------------------------------------------ -profile hpc
    slurm_account              = null    // your allocation; set it in your params file or a -c config
    slurm_partition            = 'batch'
    slurm_extra                = null    // e.g. '--qos=normal --constraint=cascadelake'
}

// Backwards compatibility for publishDir syntax
outputDir = params.outdir
workflow.output.mode = params.publish_dir_mode

// Load base.config by default for all pipelines
includeConfig 'conf/base.config'

profiles {
    debug {
        dumpHashes              = true
        process.beforeScript    = 'echo $HOSTNAME'
        cleanup                 = false
        nextflow.enable.configProcessNamesValidation = true
    }
    conda {
        conda.enabled           = true
        docker.enabled          = false
        singularity.enabled     = false
        podman.enabled          = false
        shifter.enabled         = false
        charliecloud.enabled    = false
        conda.channels          = ['conda-forge', 'bioconda']
        apptainer.enabled       = false
    }
    mamba {
        conda.enabled           = true
        conda.useMamba          = true
        docker.enabled          = false
        singularity.enabled     = false
        podman.enabled          = false
        shifter.enabled         = false
        charliecloud.enabled    = false
        apptainer.enabled       = false
    }
    docker {
        docker.enabled          = true
        conda.enabled           = false
        singularity.enabled     = false
        podman.enabled          = false
        shifter.enabled         = false
        charliecloud.enabled    = false
        apptainer.enabled       = false
        docker.runOptions       = '-u $(id -u):$(id -g)'
    }
    arm64 {
        process.arch            = 'arm64'
        // TODO https://github.com/nf-core/modules/issues/6694
        // For now if you're using arm64 you have to use wave for the sake of the maintainers
        // wave profile
        apptainer.ociAutoPull   = true
        singularity.ociAutoPull = true
        wave.enabled            = true
        wave.freeze             = true
        wave.strategy           = 'conda,container'
    }
    emulate_amd64 {
        docker.runOptions       = '-u $(id -u):$(id -g) --platform=linux/amd64'
    }
    singularity {
        singularity.enabled     = true
        singularity.autoMounts  = true
        conda.enabled           = false
        docker.enabled          = false
        podman.enabled          = false
        shifter.enabled         = false
        charliecloud.enabled    = false
        apptainer.enabled       = false
    }
    podman {
        podman.enabled          = true
        conda.enabled           = false
        docker.enabled          = false
        singularity.enabled     = false
        shifter.enabled         = false
        charliecloud.enabled    = false
        apptainer.enabled       = false
    }
    shifter {
        shifter.enabled         = true
        conda.enabled           = false
        docker.enabled          = false
        singularity.enabled     = false
        podman.enabled          = false
        charliecloud.enabled    = false
        apptainer.enabled       = false
    }
    charliecloud {
        charliecloud.enabled    = true
        conda.enabled           = false
        docker.enabled          = false
        singularity.enabled     = false
        podman.enabled          = false
        shifter.enabled         = false
        apptainer.enabled       = false
    }
    apptainer {
        apptainer.enabled       = true
        apptainer.autoMounts    = true
        conda.enabled           = false
        docker.enabled          = false
        singularity.enabled     = false
        podman.enabled          = false
        shifter.enabled         = false
        charliecloud.enabled    = false
    }
    wave {
        apptainer.ociAutoPull   = true
        singularity.ociAutoPull = true
        wave.enabled            = true
        wave.freeze             = true
        wave.strategy           = 'conda,container'
    }
    gpu {
        docker.runOptions       = '-u $(id -u):$(id -g) --gpus all'
        apptainer.runOptions    = '--nv'
        singularity.runOptions  = '--nv'
    }
    test       { includeConfig 'conf/test.config'       }
    hpc        { includeConfig 'conf/hpc.config'        }
    slurm      { process.executor = 'slurm'             }
    envmodules { includeConfig 'conf/envmodules.config' }
}

// Load nf-core custom profiles from different institutions

// If params.custom_config_base is set AND either the NXF_OFFLINE environment variable is not set or params.custom_config_base is a local path, the nfcore_custom.config file from the specified base path is included.
// Load bioinfo-kaust/hybrid-metatranscriptomics custom profiles from different institutions.
includeConfig params.custom_config_base && (!System.getenv('NXF_OFFLINE') || !params.custom_config_base.startsWith('http')) ? "${params.custom_config_base}/nfcore_custom.config" : "/dev/null"



// Set default registry for Apptainer, Docker, Podman, Charliecloud and Singularity independent of -profile
// Will not be used unless Apptainer / Docker / Podman / Charliecloud / Singularity are enabled
// Set to your registry if you have a mirror of containers
apptainer.registry    = 'quay.io'
docker.registry       = 'quay.io'
podman.registry       = 'quay.io'
singularity.registry  = 'quay.io'
charliecloud.registry = 'quay.io'



// Export these variables to prevent local Python/R libraries from conflicting with those in the container
// The JULIA depot path has been adjusted to a fixed path `/usr/local/share/julia` that needs to be used for packages in the container.
// See https://apeltzer.github.io/post/03-julia-lang-nextflow/ for details on that. Once we have a common agreement on where to keep Julia packages, this is adjustable.

env {
    PYTHONNOUSERSITE = 1
    R_PROFILE_USER   = "/.Rprofile"
    R_ENVIRON_USER   = "/.Renviron"
    JULIA_DEPOT_PATH = "/usr/local/share/julia"
}

// Set bash options. No `-C` (noclobber), unlike the nf-core template: the local scripts
// create a file and then rewrite it with `>` (e.g. the audit's empty class files), which
// noclobber turns into a task failure.
process.shell = [
    "bash",
    "-e",         // Exit if a tool returns a non-zero status/exit code
    "-u",         // Treat unset variables and parameters as an error
    "-o",         // Returns the status of the last command to exit..
    "pipefail"    //   ..with a non-zero status or zero if all successfully execute
]

// Disable process selector warnings by default. Use debug profile to enable warnings.
nextflow.enable.configProcessNamesValidation = false

timeline {
    enabled = true
    file    = "${params.outdir}/pipeline_info/execution_timeline_${params.trace_report_suffix}.html"
}
report {
    enabled = true
    file    = "${params.outdir}/pipeline_info/execution_report_${params.trace_report_suffix}.html"
}
trace {
    enabled = true
    file    = "${params.outdir}/pipeline_info/execution_trace_${params.trace_report_suffix}.txt"
}
dag {
    enabled = true
    file    = "${params.outdir}/pipeline_info/pipeline_dag_${params.trace_report_suffix}.html"
}

manifest {
    name            = 'bioinfo-kaust/hybrid-metatranscriptomics'
    contributors    = [
        [
            name: 'BioCore Lab',
            affiliation: 'KAUST',
            email: '',
            github: 'bioinfo-kaust',
            contribution: ['author', 'maintainer'], // List of contribution types ('author', 'maintainer' or 'contributor')
            orcid: ''
        ],
    ]
    homePage        = 'https://github.com/bioinfo-kaust/hybrid-metatranscriptomics'
    description     = """Host-only transcriptome reconstruction from long + short reads with pre-assembly decontamination, annotation, quantification and DGE"""
    mainScript      = 'main.nf'
    defaultBranch   = 'main'
    nextflowVersion = '!>=25.10.4'
    version         = '2.0.0dev'
    doi             = ''
}

// Nextflow plugins
plugins {
    id 'nf-schema@2.5.1' // Validation of pipeline parameters and creation of an input channel from a sample sheet
}

validation {
    defaultIgnoreParams = ["genomes", "mod"]
    monochromeLogs = params.monochrome_logs
}
// Load modules.config for DSL2 module specific options
includeConfig 'conf/modules.config'
